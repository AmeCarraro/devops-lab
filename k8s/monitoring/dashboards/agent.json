        }
      }
    },
    {
      "type": "timeseries",
      "title": "Prompt tokens per call by mode",
      "description": "How much text each call makes the model read. It grows with the excerpts the research collects.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (mode) (rate(llm_tokens_total{namespace=\"demo\", kind=\"prompt\"}[5m])) / sum by (mode) (rate(llm_requests_total{namespace=\"demo\", outcome=\"ok\"}[5m]))",
          "legendFormat": "{{mode}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
