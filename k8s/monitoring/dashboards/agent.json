          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(agent_run_duration_seconds_bucket{namespace=\"demo\"}[15m])))",
          "legendFormat": "p50",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
