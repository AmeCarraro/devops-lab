      }
    },
    {
      "type": "timeseries",
      "title": "Steps and excerpts per run",
      "description": "Averages over the runs that completed. More steps for the same excerpts means the model searches in circles.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(agent_run_steps_sum{namespace=\"demo\"}[15m])) / sum(rate(agent_run_steps_count{namespace=\"demo\"}[15m]))",
          "legendFormat": "steps",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
